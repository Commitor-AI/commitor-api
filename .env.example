DATABASE_URL=postgresql+asyncpg://commitor:change-me@localhost:5432/commitor
JWT_SECRET=generate-me-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=1440
LOGIN_RATE_LIMIT=10
SIGNUP_RATE_LIMIT=5
RATE_LIMIT_WINDOW_SECONDS=300
OPENROUTER_API_KEY=
OPENROUTER_MODEL=stealth/ox-alpha
OPENROUTER_REASONING_MODEL=stealth/ox-alpha
# Comma-separated emails the backend trusts as verified admins. Membership
# here is the source of truth for admin status (the CLI `gimme admin`
# flow only succeeds for these accounts).
ADMIN_EMAILS=
